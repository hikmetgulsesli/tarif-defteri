{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vitest/globals"]
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/screens/BasariBildirimiToast.tsx",
    "src/screens/BosDurumAramaSonucuYok.tsx",
    "src/screens/BosDurumFavoriYok.tsx",
    "src/screens/BosDurumTarifYok.tsx",
    "src/screens/Favoriler.tsx",
    "src/screens/LezzetDefteriPrdSummary.tsx",
    "src/screens/SilmeOnayDiyalogu.tsx",
    "src/screens/TarifDetay.tsx",
    "src/screens/TariflerAnaSayfa.tsx"
  ]
}
